// harrisonkeen.tech — Cloudflare Worker with static assets (moved off Netlify 2026-11-20).
// The repo root is the site; .assetsignore keeps tooling, drafts and the big acting
// videos (served from R2 by worker/index.js) out of the asset upload.
{
  "name": "hk-website",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": false,
  // Apex is a Workers custom domain (Cloudflare manages its DNS record). www stays a
  // proxied CNAME to the apex.
  "routes": [{ "pattern": "harrisonkeen.tech", "custom_domain": true }],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": ["/googlef482c8a3045fc8bc.html"]
  },
  "vars": {
    "SENDER": "Harrison Keen <hello@harrisonkeen.tech>",
    "OWNER_EMAIL": "keen_ha@outlook.com"
  },
  // RESEND_API_KEY is a secret: wrangler secret put RESEND_API_KEY
  "d1_databases": [
    { "binding": "DB", "database_name": "hk-forms", "database_id": "46f0429e-fa46-43b0-98a7-d7a07e341cb5" }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "hk-media" }
  ],
  "observability": { "enabled": true }
}
